{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".reference/**",
    "dist/**",
    "docs/**",
    "test/schema/**",
    "tools/oxlint/anti-slop/**",
    "pnpm-lock.yaml",
    "CLAUDE.md",
    "CONTEXT.md"
  ]
}
