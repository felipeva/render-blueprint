    },
    {
      "files": ["src/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "!../index.js"],
                "message": "structure.md §3.1: cli/ is L11; it imports index.ts and its own files, nothing else in src/. If index.ts does not export what you need, export it."
              },
              {
                "group": ["./**/*.test.js", "./**/*.test-d.js"],
                "message": "structure.md §3.1: no source file may import a test file."
              },
              {
                "group": [
                  "zod",
                  "zod/**",
                  "yaml",
                  "yaml/**",
                  "node:*",
                  "node:*/**",
