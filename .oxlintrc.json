                  "ajv/**",
                  "ajv-formats",
                  "ajv-formats/**",
                  "vitest",
                  "vitest/**",
                  "!node:path",
                  "!node:url"
                ],
                "message": "structure.md §3.1: cli/ owns brocli and may import better-result, node:path and node:url; every read and write goes through the FilePort it takes from index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.test-d.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/test/**", "!**/test/support/**"],
                "message": "structure.md §3.1: a test file may import anything under src/ and anything under test/support/; a fixture is consumer-style sample code, not a helper."
              },
              {
                "group": ["ajv", "ajv/**", "ajv-formats", "ajv-formats/**"],
                "message": "structure.md §3.1: ajv and ajv-formats are the conformance oracle in test/support/ and nothing else."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["ajv", "ajv/**", "ajv-formats", "ajv-formats/**"],
                "message": "structure.md §3.1: ajv and ajv-formats are the conformance oracle in test/support/ and nothing else."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/support/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
