                  "ajv",
                  "ajv/**",
                  "ajv-formats",
                  "ajv-formats/**",
                  "vitest",
                  "vitest/**"
                ],
                "message": "structure.md §3.1: the published entrypoints re-export src/ only; no runtime dependency belongs in them."
              }
