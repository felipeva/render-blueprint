                  "!../defaults/**",
                  "!../blueprint/**",
                  "!../validation/**",
                  "!../synth/**",
                  "!../fs/**"
                ],
                "message": "structure.md §3.1: drift/ is L9; it may import L0-L8 and its own files."
              },
              {
                "group": ["./**/*.test.js", "./**/*.test-d.js"],
                "message": "structure.md §3.1: no source file may import a test file."
              },
              {
                "group": [
                  "zod",
                  "zod/**",
                  "yaml",
                  "yaml/**",
                  "node:*",
                  "node:*/**",
                  "@drizzle-team/brocli",
                  "@drizzle-team/brocli/**",
                  "ajv",
                  "ajv/**",
                  "ajv-formats",
                  "ajv-formats/**",
                  "vitest",
                  "vitest/**"
                ],
                "message": "structure.md §3.1: drift/ may import better-result only; it receives a JsonValue, never YAML or a file path."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/index.ts", "src/testing.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "./cli/**", "./index.js", "./testing.js"],
                "message": "structure.md §3.1: index.ts and testing.ts are L10; they may import L0-L9, never cli/ and never each other."
              },
              {
                "group": ["./**/*.test.js", "./**/*.test-d.js"],
                "message": "structure.md §3.1: no source file may import a test file."
              },
              {
                "group": [
                  "zod",
                  "zod/**",
                  "better-result",
                  "better-result/**",
                  "yaml",
                  "yaml/**",
                  "node:*",
                  "node:*/**",
                  "@drizzle-team/brocli",
