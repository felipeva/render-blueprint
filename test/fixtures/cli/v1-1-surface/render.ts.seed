import {
  blueprint,
  external,
  withDefaults,
  type Blueprint,
  type IpAllowList,
  type MaintenanceMode,
  type ResourceFactories,
} from '__RENDER_BLUEPRINT__';

// spec §7: one entry form serves every kind that takes a list, so the scope hands the same value to
// the web service and to the database.
const OFFICE: IpAllowList = [
  { source: '203.0.113.4/30', description: 'office' },
  { source: '198.51.100.1', description: 'ci runner' },
];

// spec §4.8: the uri is the absolute URL Render serves the page from while the service is down.
const MAINTENANCE: MaintenanceMode = {
  enabled: false,
  uri: 'https://status.acme.dev/maintenance',
};

const credential = external.registryCredential('acme-dockerhub');

const acme: ResourceFactories = withDefaults({
  region: 'oregon',
  autoDeployTrigger: 'checksPass',
  buildFilter: { paths: ['apps/**'], ignoredPaths: ['docs/**'] },
  ipAllowList: OFFICE,
  plan: {
    web: 'starter',
    privateService: 'starter',
    worker: 'starter',
    keyValue: 'standard',
    postgres: 'basic-1gb',
  },
});

const records = acme.postgres('records', {
  diskSizeGB: 20,
  storageAutoscalingEnabled: true,
  connectionPool: 'pgbouncer',
});

// spec §4.1: `disabled` leaves the custom domains as the only address Render answers on, so the
// service lists one.
const api = acme.web('api', {
  runtime: 'node',
  repo: 'https://github.com/acme/mono',
  branch: 'main',
  rootDir: 'apps/api',
  buildCommand: 'pnpm install --frozen-lockfile && pnpm build',
  startCommand: 'pnpm start',
  domains: ['api.acme.dev'],
  initialDeployHook: './scripts/seed-database.sh',
  maintenanceMode: MAINTENANCE,
  renderSubdomainPolicy: 'disabled',
  env: { DATABASE_URL: records.connectionPoolString, LOG_FORMAT: 'json' },
});

// The site's own allow list replaces the scope's whole, and it takes the build filter and the
// deploy trigger the scope declares.
const marketing = acme.staticSite('marketing', {
  repo: 'https://github.com/acme/mono',
  branch: 'main',
  rootDir: 'apps/marketing',
  buildCommand: 'pnpm install --frozen-lockfile && pnpm build',
  staticPublishPath: './dist',
  domains: ['acme.dev', 'www.acme.dev'],
  ipAllowList: [{ source: '198.51.100.0/24', description: 'edge' }],
  renderSubdomainPolicy: 'disabled',
});

// spec §4.2: the credential names the workspace credential that pulls the private base image the
// Dockerfile builds on.
const jobs = acme.worker('jobs', {
  runtime: 'docker',
  repo: 'https://github.com/acme/mono',
  branch: 'main',
  rootDir: 'apps/jobs',
  dockerfilePath: './Dockerfile',
  dockerContext: './',
  registryCredential: credential,
  env: { JOBS_LOG_LEVEL: 'info' },
});

// spec §4.3: a prebuilt image names no repository, so neither the build filter nor the deploy
// trigger the scope declares reaches this service.
const pdf = acme.privateService('pdf', {
  runtime: 'image',
  image: { url: 'ghcr.io/acme/pdf:1.4.0' },
});

// spec §5: a Key Value instance requires its own allow list, so the scope's never reaches one.
const cache = acme.keyValue('cache', {
  ipAllowList: [{ source: '10.0.0.0/8', description: 'private network' }],
});

const value: Blueprint = blueprint({
  resources: [api, marketing, jobs, pdf, cache, records],
});

export default value;
